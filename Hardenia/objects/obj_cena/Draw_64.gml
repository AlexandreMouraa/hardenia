var _w = display_get_gui_width();
var _h = display_get_gui_height();
var _esc = max(1, _h / 540);
// faixas entram e saem nos primeiros e ultimos 15 frames
var _t = min(1, min(tempo, duracao - tempo) / 15);
var _faixa = 54 * _esc * _t;
draw_set_color(c_black);
draw_rectangle(0, 0, _w, _faixa, false);
draw_rectangle(0, _h - _faixa, _w, _h, false);
draw_set_halign(fa_center);
draw_set_valign(fa_middle);
var _texto_t = clamp((tempo - 20) / 20, 0, 1) * _t;
draw_set_alpha(_texto_t);
draw_set_color(cor);
titulo(_w / 2, _h * 0.68, nome, _esc * 2.8);
draw_set_color(c_white);
texto(_w / 2, _h * 0.68 + 44 * _esc, frase, _esc * 1.05, _esc * 1.05, 0);
draw_set_alpha(1);
draw_set_color(c_white);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
